# Copy this file to .env and fill in your own keys.

# Clerk authentication (dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase PostgreSQL (Project -> Connect)
# Transaction pooler (port 6543), with ?pgbouncer=true at the end
DATABASE_URL=
# Direct or session connection (port 5432), used by Prisma migrations
DIRECT_URL=

# Google Gemini (aistudio.google.com -> Get API key)
GEMINI_API_KEY=

# Arcjet rate limiting (app.arcjet.com)
ARCJET_KEY=

# Resend email (optional for the demo)
RESEND_API_KEY=
