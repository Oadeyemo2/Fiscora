# Copy this file to .env and fill in your own keys.

# Clerk authentication (dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase PostgreSQL (Project -> Connect)
# Transaction pooler (port 6543), with ?pgbouncer=true at the end
DATABASE_URL=
# Direct or session connection (port 5432), used by Prisma migrations
DIRECT_URL=

# Google Gemini (aistudio.google.com -> Get API key)
GEMINI_API_KEY=
# Optional: Gemini model (default gemini-3.5-flash-lite)
GEMINI_MODEL=

# Admins: comma-separated emails that get the admin role when they sign in
ADMIN_EMAILS=

# Resend email (resend.com -> API Keys)
RESEND_API_KEY=

# Inngest scheduled jobs (set by the Inngest integration on Vercel)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Vercel Blob receipt photos (set when the Blob store is connected)
BLOB_READ_WRITE_TOKEN=
